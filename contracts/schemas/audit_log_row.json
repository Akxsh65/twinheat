{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://twinheat.invalid/contracts/1.0/audit_log_row.json",
  "title": "audit_log_row",
  "description": "One CSV row of the audit log, one per committed proposal (CLAUDE.md §10.4), after parsing to typed values. Every column is always present; null = empty cell. s, r_hot, sd_hot, B, T_lo, T_hi, oracle_peak in K; q_t and S_hi are dimensionless scores (S = error / s); q_t and B null = not applicable to this gate, or +inf. T_lo, T_hi, S_hi, err null on unaudited rows; oracle_peak only offline.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version", "run_id", "gate", "seed", "t", "proposer", "aggressiveness", "group", "x_hash",
    "s", "r_hot", "sd_hot", "q_t", "B", "decision", "p_t", "audited", "T_lo", "T_hi", "S_hi", "err",
    "alpha_t", "iters_used", "oracle_peak"
  ],
  "properties": {
    "schema_version": { "$ref": "#/$defs/schema_version" },
    "run_id": {
      "type": "string",
      "pattern": "^.+-[0-9a-f]{7,40}-[0-9]+$",
      "description": "<config>-<commit>-<seed> (CLAUDE.md §4)"
    },
    "gate": { "enum": ["G0", "G1", "G2", "G3", "G4", "G5", "G6", "G7"] },
    "seed": { "type": "integer", "minimum": 0 },
    "t": { "type": "integer", "minimum": 0 },
    "proposer": { "enum": ["P1", "P2", "P3", "P4"] },
    "aggressiveness": { "enum": [1, 2, 3, null], "description": "level 1..3 (§11.2); null for P4, which has no knob" },
    "group": { "type": ["string", "null"], "minLength": 1 },
    "x_hash": { "$ref": "#/$defs/hash" },
    "s": { "type": "number", "exclusiveMinimum": 0 },
    "r_hot": { "type": "number", "minimum": 0 },
    "sd_hot": { "type": "number", "minimum": 0 },
    "q_t": { "type": ["number", "null"], "minimum": 0 },
    "B": { "type": ["number", "null"], "minimum": 0 },
    "decision": { "enum": ["accept", "flag", "audit"] },
    "p_t": { "type": "number", "minimum": 0, "maximum": 1 },
    "audited": { "type": "boolean" },
    "T_lo": { "type": ["number", "null"] },
    "T_hi": { "type": ["number", "null"] },
    "S_hi": { "type": ["number", "null"], "minimum": 0 },
    "err": { "enum": [0, 1, null] },
    "alpha_t": { "type": ["number", "null"] },
    "iters_used": { "type": "integer", "minimum": 0 },
    "oracle_peak": { "type": ["number", "null"] }
  },
  "$defs": {
    "schema_version": { "const": "1.0" },
    "hash": { "type": "string", "pattern": "^[0-9a-f]{64}$", "description": "SHA-256, lowercase hex" }
  }
}
